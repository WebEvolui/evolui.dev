---
import { courses } from "../../data/courses";
import HeroSectionCurso from "../../components/HeroSectionCurso.astro";
import Layout from "../../layouts/Layout.astro";

// Define as rotas dinâmicas
export async function getStaticPaths() {
  return courses.map((course) => ({
    params: { id: course.id }, // Parâmetro dinâmico
  }));
}

const { id } = Astro.params;
const course = courses.find((course) => course.id === id);

if (!course) {
  throw new Error(`Curso com ID '${id}' não encontrado.`);
}
---

<Layout
  title={`${course.title} | Evolui.dev`}
  description={course.description}
  image={course.image}
  imageAlt={`Capa do curso: ${course.title}`}
  url={`/curso/${course.id}/`}
>
  <main id="main-content" class="space-y-20 mb-40">
    <HeroSectionCurso
      title={course.title}
      description={course.description}
      image={course.image}
      link={course.link}
      label={course.label}
    />
  </main>
</Layout>
