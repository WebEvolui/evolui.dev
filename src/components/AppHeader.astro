---
import Container from "./Container.astro";
import { Image } from "astro:assets";
import logo from "../assets/evolui.dev.png";
---

<header class="absolute inset-x-0 top-0 z-10">
  <nav aria-label="Navegação principal">
    <Container>
      <div class="flex items-center justify-between gap-4 py-4 md:py-5">
        <a href="/" aria-label="Página inicial da Evolui.dev" class="flex items-center rounded-full">
          <Image
            src={logo}
            alt="Evolui.dev"
            width={128}
            height={128}
            format="webp"
            quality="high"
            priority
            class="h-12 w-12 md:h-14 md:w-14"
          />
        </a>

        <div class="hidden items-center gap-7 text-sm font-semibold text-slate-200 md:flex">
          <a class="transition hover:text-primary" href="/#courses">Cursos</a>
          <a class="transition hover:text-primary" href="/#community">Comunidade</a>
          <a
            class="rounded-full bg-primary px-5 py-2.5 text-slate-950 transition hover:bg-cyan-300"
            href="https://github.com/WebEvolui/evolui.dev"
          >
            GitHub
          </a>
        </div>

        <a
          class="rounded-full bg-primary px-4 py-2 text-sm font-semibold text-slate-950 transition hover:bg-cyan-300 md:hidden"
          href="https://github.com/WebEvolui/evolui.dev"
        >
          GitHub
        </a>
      </div>
    </Container>
  </nav>
</header>
