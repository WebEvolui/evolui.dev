---
import Container from "./Container.astro";
import { Image } from "astro:assets";
import { courses } from "../data/courses";

const courseDetailsUrl = (course) => `/curso/${course.id}`;
---

<section id="courses" aria-labelledby="courses-title">
  <Container>
    <div class="mb-12 space-y-2 text-center">
      <h2 id="courses-title" class="text-3xl font-bold text-gray-800 md:text-4xl dark:text-white">
        Nossos cursos
      </h2>
      <p class="lg:mx-auto lg:w-6/12 text-gray-600 dark:text-gray-300">
        Já temos vários cursos disponíveis para você, e estamos sempre lançando
        novos cursos, então fique ligado!
      </p>
    </div>
      <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
      {
        courses.map((course) => (
          <article
            class="group flex h-full flex-col p-6 rounded-3xl bg-white border border-gray-100 dark:shadow-none dark:border-gray-700 dark:bg-gray-800 bg-opacity-50 shadow-2xl shadow-gray-600/10"
          >
            <a
              href={courseDetailsUrl(course)}
              aria-label={`Ver detalhes do curso ${course.title}`}
              class="relative block overflow-hidden rounded-xl bg-gray-100 dark:bg-gray-700 aspect-[750/422] focus:outline-none focus-visible:ring-4 focus-visible:ring-primary/60"
            >
              <Image
                src={course.image}
                alt={`Capa do curso ${course.title}`}
                loading="lazy"
                width={750}
                height={422}
                widths={[320, 480, 640, 750]}
                sizes="(min-width: 1024px) 31vw, (min-width: 768px) 45vw, 100vw"
                format="webp"
                quality="mid"
                class="h-full w-full object-contain transition duration-500 group-hover:scale-105"
              />
            </a>
            <div class="mt-6 relative flex flex-1 flex-col">
              <h3 class="text-2xl font-semibold text-gray-800 dark:text-white">
                {course.title}
              </h3>
              <p class="mt-6 text-gray-600 dark:text-gray-300">
                {course.description}
              </p>
              <div class="mt-auto pt-8 flex items-center justify-between">
                <a class="inline-block" href={courseDetailsUrl(course)}>
                  <span class="font-semibold text-cyan-800 hover:text-cyan-950 dark:text-cyan-400 dark:hover:text-cyan-300">
                    Mais detalhes
                  </span>
                </a>
                <a
                  href={course.link}
                  class="inline-block rounded-md bg-primary px-4 py-2 font-semibold text-slate-950 shadow-md transition-colors duration-300 hover:bg-secondary"
                >
                  Comprar
                </a>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </Container>
</section>
