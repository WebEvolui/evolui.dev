---
import Container from "./Container.astro";
import HeroBackdrop from "./HeroBackdrop.astro";
import { Image } from "astro:assets";
const { title, description, image, link, label } = Astro.props;
---

<section class="relative isolate overflow-hidden" aria-labelledby="course-title">
  <HeroBackdrop />
  <Container>
    <div class="relative py-20 md:py-28 ml-auto">
      <div class="lg:w-2/3 text-center mx-auto">
        <div class="flex justify-center mb-8">
          <Image
            src={image}
            alt={`Capa do curso ${title}`}
            width={750}
            height={422}
            widths={[320, 480, 640, 750]}
            sizes="(min-width: 768px) 384px, calc(100vw - 3rem)"
            format="webp"
            quality="high"
            priority
            class="w-96 rounded-xl border border-white/20 shadow-2xl shadow-black/40"
          />
        </div>
        <h1
          id="course-title"
          class="text-white font-bold text-2xl md:text-3xl xl:text-4xl"
        >
          <span class="text-white">{title}</span>
        </h1>
        <p class="mt-8 text-slate-200">
          {description}
        </p>
        <div class="mt-8">
          <a
            href={link}
            class="inline-block bg-primary hover:bg-secondary text-slate-950 font-semibold py-3 px-6 rounded-md shadow-md transition-all duration-300"
          >
            Comprar com desconto
          </a>
        </div>
        <p class="mt-6 text-slate-300 text-sm">
          Gostou do curso?{" "}
          <a
            href={`https://github.com/WebEvolui/evolui.dev/issues/new?labels=curso,sugest%C3%A3o,${label}`}
            rel="noopener noreferrer"
            class="text-primary hover:text-white hover:underline"
          >
            Comente sobre ele no nosso GitHub
          </a>
          {" "}e ajude a melhorá-lo!
        </p>
      </div>
    </div>
  </Container>
</section>
