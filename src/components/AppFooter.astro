---
import Container from "./Container.astro";
const currentYear = new Date().getFullYear();
---

<footer class="bg-gray-800 py-12 text-white">
  <Container>
    <div class="flex flex-col items-center justify-between gap-6 text-center md:flex-row md:text-start">
      <p class="text-sm text-slate-300">
        © {currentYear} Web Evolui · CNPJ 24.519.549/0001-55
      </p>
      <nav aria-label="Links institucionais" class="flex flex-wrap justify-center gap-x-5 gap-y-3 text-sm font-semibold">
        <a class="transition hover:text-primary" href="https://github.com/WebEvolui">GitHub</a>
        <a class="transition hover:text-primary" href="https://www.youtube.com/@WebDutras">YouTube</a>
        <a class="transition hover:text-primary" href="https://www.linkedin.com/company/web-evolui">LinkedIn</a>
        <a class="transition hover:text-primary" href="https://www.facebook.com/WebEvolui">Facebook</a>
      </nav>
    </div>
  </Container>
</footer>
