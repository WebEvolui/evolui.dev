---
import Container from "./Container.astro";
import HeroBackdrop from "./HeroBackdrop.astro";
const {
  titlePart1 = "Evolui",
  titlePart2 = ".dev",
  description = "Sabia que você pode entrar para a nossa comunidade exclusiva comprando um de nossos cursos? Então não perca tempo e venha fazer parte da nossa comunidade!",
} = Astro.props;
---

<section class="relative isolate overflow-hidden" aria-labelledby="hero-title">
  <HeroBackdrop />
  <Container>
    <div class="relative py-24 md:py-32 lg:py-36 ml-auto">
      <div class="lg:w-2/3 text-center mx-auto">
        <h1
          id="hero-title"
          class="text-white font-bold text-5xl md:text-6xl xl:text-7xl drop-shadow-sm"
        >
          {titlePart1}<span class="text-primary"
            >{titlePart2}</span
          >
        </h1>
        <p class="mt-8 text-lg leading-relaxed text-slate-200 md:text-xl">
          {description}
        </p>
      </div>
    </div>
  </Container>
</section>
