---
import Container from "./Container.astro";
import { Image } from "astro:assets";
import youtubeBanner from "../assets/canal-webdutras-ewerton-dutra-conteudo-de-graca.png";
import memberEventBanner from "../assets/evento-empreendendo-sendo-programador-membros-nivel-2-webdutras.png";
---

<section id="content" class="py-16" aria-labelledby="content-title">
  <Container>
    <div class="mb-12 space-y-2 text-center">
      <h2 id="content-title" class="text-3xl font-bold text-gray-800 md:text-4xl dark:text-white">
        Conteúdo gratuito e eventos exclusivos
      </h2>
      <p class="lg:mx-auto lg:w-6/12 text-gray-600 dark:text-gray-300">
        Acompanhe o canal no YouTube e conheça os eventos para membros do canal.
      </p>
    </div>

    <div class="grid gap-8 lg:grid-cols-2">
      <article class="group flex flex-col justify-between rounded-3xl border border-gray-100 bg-white/50 p-8 shadow-2xl shadow-gray-600/10 dark:border-gray-700 dark:bg-gray-800 dark:shadow-none">
        <div>
          <div class="mb-6 flex items-center gap-3">
            <span class="inline-flex items-center rounded-full bg-red-500/10 px-4 py-1.5 text-sm font-semibold text-red-800 dark:text-red-300">YouTube</span>
            <span class="inline-flex items-center rounded-full bg-green-500/10 px-4 py-1.5 text-sm font-semibold text-green-800 dark:text-green-300">Conteúdo gratuito</span>
          </div>
          <h3 class="text-3xl font-bold text-gray-800 md:text-4xl dark:text-white">Acompanhe o canal no YouTube</h3>
          <p class="mt-4 text-lg text-gray-600 dark:text-gray-300">
            Aulas, projetos e dicas para você evoluir como desenvolvedor(a).
          </p>
        </div>
        <div class="mt-8">
          <div class="overflow-hidden rounded-2xl bg-gray-100 dark:bg-gray-700">
            <Image
              src={youtubeBanner}
              alt="Canal WebDutras, de Ewerton Dutra"
              loading="lazy"
              width={750}
              height={422}
              widths={[360, 540, 750]}
              sizes="(min-width: 1024px) 40vw, 100vw"
              format="webp"
              quality="mid"
              class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
            />
          </div>
          <a
            href="https://www.youtube.com/channel/UC1eSF-wA6ScYUdAj-nq5TFA?sub_confirmation=1"
            class="mt-6 inline-flex h-12 w-full items-center justify-center rounded-full bg-red-600 px-8 text-base font-semibold text-white transition hover:bg-red-700 sm:w-max"
          >
            Inscrever-se no canal
          </a>
        </div>
      </article>

      <article class="group flex flex-col justify-between rounded-3xl border border-gray-100 bg-white/50 p-8 shadow-2xl shadow-gray-600/10 dark:border-gray-700 dark:bg-gray-800 dark:shadow-none">
        <div>
          <div class="mb-6 flex items-center gap-3">
            <span class="inline-flex items-center rounded-full bg-primary/10 px-4 py-1.5 text-sm font-semibold text-cyan-800 dark:text-cyan-300">Evento exclusivo</span>
            <span class="inline-flex items-center rounded-full bg-secondary/10 px-4 py-1.5 text-sm font-semibold text-orange-800 dark:text-orange-300">Membros nível 2</span>
          </div>
          <h3 class="text-3xl font-bold text-gray-800 md:text-4xl dark:text-white">Evento para membros nível 2</h3>
          <p class="mt-4 text-lg text-gray-600 dark:text-gray-300">
            Participe de encontros ao vivo, conteúdos especiais e muito mais.
          </p>
        </div>
        <div class="mt-8">
          <div class="overflow-hidden rounded-2xl bg-gray-100 dark:bg-gray-700">
            <Image
              src={memberEventBanner}
              alt="Evento para membros nível 2 do canal"
              loading="lazy"
              width={750}
              height={422}
              widths={[360, 540, 750]}
              sizes="(min-width: 1024px) 40vw, 100vw"
              format="webp"
              quality="mid"
              class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
            />
          </div>
          <a
            href="https://www.youtube.com/@WebDutras/join"
            class="mt-6 inline-flex h-12 w-full items-center justify-center rounded-full bg-primary px-8 text-base font-semibold text-slate-950 transition hover:bg-cyan-300 sm:w-max"
          >
            Tornar-se membro
          </a>
        </div>
      </article>
    </div>
  </Container>
</section>
