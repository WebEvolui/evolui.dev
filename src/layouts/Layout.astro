---
import { AstroFont } from "astro-font";
import { getImage } from "astro:assets";
import AppFooter from "../components/AppFooter.astro";
import AppHeader from "../components/AppHeader.astro";
import socialPreview from "../assets/evolui-social-preview.png";
import "../styles/global.css";

const siteUrl = "https://evolui.dev";
const {
  title = "Evolui.dev - Cursos de programação e comunidade",
  description = "Evolui.dev - Aqui você evolui como desenvolvedor(a)",
  image,
  imageAlt = "Evolui.dev - Cursos de programação e comunidade",
  url = "/",
  type = "website",
} = Astro.props;
const optimizedImage = await getImage({
  src: image ?? socialPreview,
  width: 1200,
  format: "jpeg",
  quality: "high",
});
const canonicalUrl = new URL(url, siteUrl).toString();
const imageUrl = new URL(optimizedImage.src, siteUrl).toString();
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/ico" href="/favicon.ico" />
    <title>{title}</title>
    <meta
      name="description"
      content={description}
    />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="generator" content={Astro.generator} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:secure_url" content={imageUrl} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Evolui.dev" />
    <meta property="og:locale" content="pt_BR" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <AstroFont
      config={[
        {
          src: [],
          name: "Urbanist",
          preload: true,
          display: "swap",
          selector: "html",
          fallback: "sans-serif",
          googleFontsURL:
            "https://fonts.googleapis.com/css2?family=Urbanist:wght@400;500;600;700&display=swap",
        },
      ]}
    />

    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-R902ECW7ZS"
    ></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());

      gtag("config", "G-R902ECW7ZS");
    </script>
  </head>
  <body class="bg-white dark:bg-gray-900">
    <AppHeader />
    <slot />
    <AppFooter />
  </body>
</html>
<style>
  html {
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
  }
</style>
