---
import { getImage } from "astro:assets";
import AppFooter from "../components/AppFooter.astro";
import AppHeader from "../components/AppHeader.astro";
import socialPreview from "../assets/evolui-social-preview.png";
import "../styles/global.css";

const siteUrl = "https://evolui.dev";
const {
  title = "Evolui.dev - Cursos de programação e comunidade",
  description = "Aprenda programação com cursos de Flutter, Laravel, Django e Go e faça parte de uma comunidade que decide os próximos conteúdos. Evolua como dev!",
  image,
  imageAlt = "Evolui.dev - Cursos de programação e comunidade",
  url = "/",
  type = "website",
} = Astro.props;
const optimizedImage = await getImage({
  src: image ?? socialPreview,
  width: 1200,
  format: "jpeg",
  quality: "high",
});
const canonicalUrl = new URL(url, siteUrl).toString();
const imageUrl = new URL(optimizedImage.src, siteUrl).toString();
const isHomePage = url === "/";
const websiteSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": `${siteUrl}/#website`,
  name: "Evolui.dev",
  url: `${siteUrl}/`,
}).replace(/</g, "\\u003c");
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, viewport-fit=cover" />
    <meta name="theme-color" content="#030d1f" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <link rel="icon" type="image/png" href="/android-chrome-192x192.png" />
    <title>{title}</title>
    <meta
      name="description"
      content={description}
    />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="generator" content={Astro.generator} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:secure_url" content={imageUrl} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:image:width" content={String(optimizedImage.width)} />
    <meta property="og:image:height" content={String(optimizedImage.height)} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Evolui.dev" />
    <meta property="og:locale" content="pt_BR" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />

  </head>
  <body class="text-slate-100">
    <a class="skip-link" href="#main-content">Pular para o conteúdo principal</a>
    <AppHeader />
    <slot />
    <AppFooter />
    {isHomePage && <script type="application/ld+json" set:html={websiteSchema} />}
  </body>
</html>
<style>
  body {
    margin: 0;
  }

  .skip-link {
    background: #fff;
    border-radius: 0.5rem;
    color: #06142b;
    inset-block-start: 1rem;
    inset-inline-start: 1rem;
    padding: 0.75rem 1rem;
    position: fixed;
    transform: translateY(-200%);
    transition: transform 150ms ease;
    z-index: 50;
  }

  .skip-link:focus {
    outline: 3px solid #06cdcc;
    outline-offset: 3px;
    transform: translateY(0);
  }
</style>
